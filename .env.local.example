# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Both variables are prefixed NEXT_PUBLIC_ because the Supabase anon key is
# safe to expose in the browser by design - it can only do what your Row
# Level Security policies (see supabase/migrations/0001_init.sql) allow.
# Never put the service_role key here or anywhere client-side.
#
# If these are left unset, Finlight automatically falls back to a local
# IndexedDB-backed auth + data adapter for development, so the app still
# runs without a Supabase project.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
